  // Gaussian copula gauge function
  real gauss_gauge_spare(real x1, real x2, real rho) {
    return (x1 + x2 - 2 * rho * sqrt(x1 * x2)) / (1 - rho^2);
  }
  
  vector gauss_gauge(vector x1, vector x2, real rho) {
    return (x1 + x2 - 2 * rho * sqrt(x1 .* x2)) / (1 - rho^2);
  }
  
  // Logistic copula gauge function
  real logistic_gauge(real x1, real x2, real dep) {
    real dep_inv = 1/dep;
    return (dep_inv * fmax(x1, x2) + (1-dep_inv)*fmin(x1,x2));
  } 
  
  // Inverse logistic copula gauge function
  real inv_log_gauge(real x1, real x2, real dep) {
    real dep_inv = 1/dep;
    return (x1^dep_inv + x2^dep_inv)^dep;
  }
  
  // Asymmetric logistic copula gauge function
  real asym_log_gauge(real x1, real x2, real dep) {
    real dep_inv = 1/dep;
    return (fmin((x1 + x2), (dep_inv * fmax(x1, x2) + (1-dep_inv) * fmin(x1, x2))));
  } 
  
  // Dirichlet gauge function
  real dirichlet_gauge(real x1, real x2, real theta1, real theta2) {
    return ((1 + theta1 + theta2) * fmax(x1, x2) - theta1 * x1 - theta2 * x2);
  } 
  
  // Rectangular gauge function
  real rectangular_gauge(real x1, real x2, real dep) {
    return (fmax(fmax((x1 - x2) / dep, (x2 - x1) / dep), (x1 + x2) / (2 - dep)));
  } 